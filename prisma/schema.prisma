generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum ImportAction {
  CREATED
  UPDATED
  MERGED
  SKIPPED
}

enum WebhookStatus {
  PENDING
  SENT
} 
  
enum ImportJobStatus {
  PENDING
  VALIDATED
  FAILED
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  password        String
  name            String?
  role            UserRole       @default(USER)
  defaultTenantId String?
  defaultTenant   Tenant?        @relation("DefaultTenant", fields: [defaultTenantId], references: [id])
  memberships     UserTenant[]
  imports         ImportJob[]
  pluginChanges   TenantPlugin[] @relation("PluginToggleUser")
  professionals   Professional[]
  importJobs      ImportJob[]
  importLogs      ImportLog[]
  importRequests  ImportRequest[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Tenant {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  members            UserTenant[]
  pluginToggles      TenantPlugin[]
  imports            ImportJob[]
  defaultUsers       User[]           @relation("DefaultTenant")
  professionals      Professional[]
  appointments       Appointment[]
  apiKeys            TenantApiKey[]
  contacts           Contact[]
  importJobs         ImportJob[]
  importRequests     ImportRequest[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  WebhookEvent       WebhookEvent[]
}

model ImportJob {
  id          String          @id @default(cuid())
  tenantId    String
  userId      String
  source      String
  fileName    String
  status      ImportJobStatus @default(PENDING)
  totalRows   Int             @default(0)
  validRows   Int             @default(0)
  invalidRows Int             @default(0)
  message     String?
  preview     Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

model SubscriptionPlan {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  description String?
  plugins     SubscriptionPlanPlugin[]
  tenants     Tenant[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model Plugin {
  id          String                   @id @default(cuid())
  key         String                   @unique
  name        String
  description String?
  category    String?
  plans       SubscriptionPlanPlugin[]
  tenants     TenantPlugin[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model SubscriptionPlanPlugin {
  id       String           @id @default(cuid())
  pluginId String
  planId   String
  plugin   Plugin           @relation(fields: [pluginId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])

  @@unique([pluginId, planId])
}

model TenantPlugin {
  id          String   @id @default(cuid())
  tenantId    String
  pluginId    String
  enabled     Boolean  @default(true)
  enabledAt   DateTime @default(now())
  enabledById String?
  enabledBy   User?    @relation("PluginToggleUser", fields: [enabledById], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  plugin      Plugin   @relation(fields: [pluginId], references: [id])

  @@unique([tenantId, pluginId])
}

model UserTenant {
  id       String     @id @default(cuid())
  userId   String
  tenantId String
  role     TenantRole @default(MEMBER)
  user     User       @relation(fields: [userId], references: [id])
  tenant   Tenant     @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
}

model Professional {
  id           String        @id @default(cuid())
  tenantId     String
  userId       String?
  name         String
  title        String?
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  professionalId String
  customerName   String
  customerEmail  String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  professional   Professional      @relation(fields: [professionalId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId, professionalId, startsAt])
}

model ImportJob {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  sourceCrm      String
  fileName       String?
  status         String    @default("PENDING")
  totalRows      Int
  processedRows  Int       @default(0)
  createdCount   Int       @default(0)
  updatedCount   Int       @default(0)
  ignoredCount   Int       @default(0)
  errorCount     Int       @default(0)
  durationMs     Int?
  errorRate      Float?
  linesPerMinute Float?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  auditSummary   String?
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
  logs           ImportLog[]

  @@index([tenantId])
  @@index([userId])
}

model ImportLog {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  level     String
  message   String
  context   Json?
  createdAt DateTime @default(now())
  job       ImportJob @relation(fields: [jobId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([jobId])
  @@index([userId])
}

model TenantApiKey {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  keyHash   String
  preview   String
  scopes    String[]
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Contact {
  id         String         @id @default(cuid())
  tenantId   String
  externalId String?
  name       String
  email      String?
  phone      String?
  tags       String[]       @default([])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  logs       ImportRecord[]

  @@unique([tenantId, externalId])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model ImportJob {
  id               String         @id @default(cuid())
  tenantId         String
  status           ImportStatus   @default(PENDING)
  source           String?
  externalUploadId String?
  dryRun           Boolean        @default(false)
  totalRecords     Int            @default(0)
  processedRecords Int            @default(0)
  failedRecords    Int            @default(0)
  errorMessage     String?
  startedAt        DateTime?      @default(now())
  completedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  records          ImportRecord[]
  changes          ImportChange[]
  webhooks         WebhookEvent[]

  @@index([tenantId, status])
}

model ImportRecord {
  id           String       @id @default(cuid())
  jobId        String
  contactId    String?
  externalId   String?
  action       ImportAction
  note         String?
  mergedIntoId String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  job          ImportJob    @relation(fields: [jobId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])

  @@index([jobId])
  @@index([contactId])
}

model ImportChange {
  id         String    @id @default(cuid())
  jobId      String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime  @default(now())
  job        ImportJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model WebhookEvent {
  id        String        @id @default(cuid())
  tenantId  String
  jobId     String?
  type      String
  payload   Json
  status    WebhookStatus @default(PENDING)
  lastError String?
  createdAt DateTime      @default(now())
  sentAt    DateTime?
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  job       ImportJob?    @relation(fields: [jobId], references: [id])

  @@index([tenantId, status])
model ImportJob {
  id            String          @id @default(cuid())
  tenantId      String
  userId        String
  dedupKey      String          @unique
  filename      String?
  csvData       String
  uploadedAt    DateTime        @default(now())
  status        ImportJobStatus @default(PENDING)
  totalRows     Int             @default(0)
  processedRows Int             @default(0)
  errorMessage  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
}

model ImportRequest {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  source    String
  fileName  String
  filePath  String
  fileSize  Int
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}
